# ─── نبغة API — مثال لمتغيرات البيئة ───
# انسخ الملف لـ .env وغيّر القيم. ممنوع رفع .env الحقيقي لـ git.

# وضع التشغيل: desktop | local | saas
DEPLOY_MODE=saas
MULTI_TENANT=true
ALLOW_NETWORK=true
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# قاعدة البيانات (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nabgha
DB_MIGRATIONS_PATH=../../packages/db/src/migrations

# JWT — استخدم قيم عشوائية طويلة ومختلفة لكل بيئة (openssl rand -hex 32)
JWT_SECRET=change-me
PLATFORM_JWT_SECRET=change-me
PARENT_JWT_SECRET=change-me
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# Redis
REDIS_URL=redis://localhost:6380

# التخزين: minio | local
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=nabgha
STORAGE_LOCAL_PATH=

# Desktop mode فقط
STATIC_PATH=
DESKTOP_TENANT_ID=
PG_DUMP_PATH=
